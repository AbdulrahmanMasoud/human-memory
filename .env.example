# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=memory_system
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory_secret

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis
REDIS_URL=redis://redis:6379/0

# Neo4j (V2+)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret

# ACT-R Parameters
ACTR_DECAY_RATE=0.5
ACTR_NOISE_STD=0.25
ACTR_RETRIEVAL_THRESHOLD=-1.0

# Embedding API (OpenAI-compatible)
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM (V2+ for consolidation extraction)
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL=llama3

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
